# --- LLM ---
# Leave both provider keys blank to run fully offline: MOCK_LLM auto-enables
# whenever no provider is configured, regardless of the MOCK_LLM value below
# (see llm/client.ts: isMockMode / resolveProvider).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Explicit override — set true to force mock mode even with a real key set
# (useful for CI). Deterministic canned responses stand in for
# intake/planner/iac_generator; deploy/verify/rollback logic is unaffected.
MOCK_LLM=false

# Which provider to use: "auto" (default) picks the first configured one
# below (Anthropic, then Bedrock, then Kiro) — this is how "fall back to
# another provider when Anthropic isn't available" works. Set to "anthropic",
# "bedrock", or "kiro" to force one explicitly (falls back to mock if that
# provider isn't configured).
LLM_PROVIDER=auto
# Kiro AI — scaffold only, not yet verified against real Kiro API docs. Fill
# these in when trial credentials are available (see llm/providers/kiroProvider.ts).
KIRO_API_KEY=
KIRO_API_BASE_URL=
KIRO_MODEL=

# Amazon Bedrock — alternative to a direct Anthropic key. Calls Anthropic
# models via Bedrock's native Converse API using an AWS Bedrock API key
# (bearer token): AWS Console -> Amazon Bedrock -> API keys -> Generate API
# key. BEDROCK_MODEL_ID is a region-prefixed inference profile ID (e.g.
# us.anthropic.claude-sonnet-4-5-20250929-v1:0), not the bare model ID. See
# llm/providers/bedrockProvider.ts.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# --- Supabase (free tier project) ---
# Project Settings -> API in the Supabase dashboard. Leave both blank to fall
# back to a local JSON file store at apps/server/data/local-store.json
# (dev-only, not for the real demo).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Deploy target ---
DEPLOY_TARGET=compose
DEPLOYMENTS_DIR=./deployments
# auto (default) = simulate deploy/verify/rollback only when the docker CLI
# is missing on this machine; true/false force one behavior. Simulated runs
# are clearly labeled "SIMULATED" in logs, audit trail, and reports.
MOCK_DEPLOY=auto
# true = skip the autocannon load test in verify (health checks still run).
SKIP_LOAD_TEST=false

# --- UC-9 AWS/Terraform: real apply/destroy (DEMO MACHINE ONLY) ---
# false (default): UC-9 stays permanently plan-only (terraform init/validate/
# plan only) — identical behavior for every contributor, judge, and the
# smoke test. true: additionally allows terraform apply/destroy/output to run
# against a REAL AWS account for the tf-ecs-fargate-v1 template, using
# whatever AWS credential chain this machine has configured (a named profile
# via AWS_PROFILE below, or the default chain from `aws configure` / env
# vars / an instance role — never hardcode a key/secret in this file).
# Real, if small, AWS cost while resources are up. NEVER set true for a
# judge-facing or CI run. After a successful live apply, run
# .\schedule-auto-destroy.ps1 in the deployment's folder right away so the
# environment doesn't outlive the demo.
ALLOW_AWS_APPLY=false
AWS_PROFILE=

# --- Server ---
PORT=4100
APPROVAL_TIMEOUT_MINUTES=30
