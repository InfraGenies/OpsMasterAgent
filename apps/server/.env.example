# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
# Set to "true" to bypass the real Anthropic API with deterministic canned
# responses for intake/planner/iac_generator. Useful for offline dev and CI
# smoke tests. The pipeline logic, validation, deploy/verify are unaffected.
MOCK_LLM=false

# --- Supabase (free tier project) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# If unset, the server falls back to a local JSON file store at
# apps/server/data/local-store.json (dev-only, not for the real demo).

# --- Deploy target ---
DEPLOY_TARGET=compose
DEPLOYMENTS_DIR=./deployments

# --- Server ---
PORT=4000
APPROVAL_TIMEOUT_MINUTES=30
