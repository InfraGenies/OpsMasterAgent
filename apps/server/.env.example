# --- LLM ---
# Leave blank to run fully offline: MOCK_LLM auto-enables whenever this is
# empty, regardless of the MOCK_LLM value below (see llm/client.ts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Explicit override — set true to force mock mode even with a real key set
# (useful for CI). Deterministic canned responses stand in for
# intake/planner/iac_generator; deploy/verify/rollback logic is unaffected.
MOCK_LLM=true

# --- Supabase (free tier project) ---
# Project Settings -> API in the Supabase dashboard. Leave both blank to fall
# back to a local JSON file store at apps/server/data/local-store.json
# (dev-only, not for the real demo).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Deploy target ---
DEPLOY_TARGET=compose
DEPLOYMENTS_DIR=./deployments
# auto (default) = simulate deploy/verify/rollback only when the docker CLI
# is missing on this machine; true/false force one behavior. Simulated runs
# are clearly labeled "SIMULATED" in logs, audit trail, and reports.
MOCK_DEPLOY=auto
# true = skip the autocannon load test in verify (health checks still run).
SKIP_LOAD_TEST=false

# --- Server ---
PORT=4100
APPROVAL_TIMEOUT_MINUTES=30
